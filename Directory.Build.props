<Project>
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildThisFileDirectory)setup/qn90a-home-route=/src/research/qn90a-home-route,$(MSBuildThisFileDirectory)telemetry/qn90a-bootstrap=/src/research/qn90a-telemetry-startup/bootstrap,$(MSBuildThisFileDirectory)native/qn90a-screensaver=/src/research/qn90a-screensaver,$(MSBuildThisFileDirectory)native/qn90a-boot-relay=/src/research/qn90a-hub-boot/relay,$(MSBuildThisFileDirectory)telemetry/s90d=/src/research/s90d-telemetry,$(MSBuildThisFileDirectory)agent/namespace-root-probe=/src/research/namespace-root-probe,$(MSBuildThisFileDirectory)agent/qn90a-root-probe=/src/research/qn90a-root-probe,$(MSBuildThisFileDirectory)agent/root-identity-probe=/src/research/root-identity-probe,$(MSBuildThisFileDirectory)agent/native-acquisition=/src/research/native-root-acquisition,$(MSBuildThisFileDirectory)setup/qn90a-app-cleanup=/src/research/qn90a-app-cleanup,$(MSBuildThisFileDirectory)native/s90d-splash=/src/research/s90d-splash,$(MSBuildThisFileDirectory)native/system-screensaver=/src/research/system-screensaver,$(MSBuildThisFileDirectory)tools/toolkit=/src/research/toolkit,$(MSBuildThisFileDirectory)tools/netdata-trial=/src/research/native-telemetry/netdata,$(MSBuildThisFileDirectory)=/src/</PathMap>
  </PropertyGroup>
</Project>
